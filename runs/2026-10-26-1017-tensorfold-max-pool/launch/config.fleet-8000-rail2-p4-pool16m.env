# MAX-POOL variant of config.fleet-8000-rail2-p4.env (2026-10-26): the shared KV pool at 16,777,216 positions (16 streams x 1,048,576), up from 2,097,152.
# Only WINDOW, TF_DS_WINDOW and --pool differ. Costs about 0.87 GiB per 1M positions on every node, allocated at boot. For Sparks that run nothing else.
# FLEET ENDPOINT config, both RoCE rails, patched engine (patch 0004: random seed per request, top_k handling). Rollback: config.fleet-8000-rail2.env (engine-bin).
# Ranks 0-1 and 2-3 are the 2D split's pairs. Fabric: rail 1 (rocep1s0f0 / enp1s0f0np0, 192.168.192.0/24), RoCE v2 GID index 3.
NODES="tonyspark2@192.168.192.2 tonyspark4@192.168.192.4 tonyspark3@192.168.192.3 tonyspark1@192.168.192.1"
MASTER_IP="192.168.192.2"
TP_PORT=29760
RDMA_HCA="rocep1s0f0,roceP2p1s0f0"
NET_IF="enp1s0f0np0"

MODEL_DIR="/var/tmp/tf1017/model"          # config, tokenizer, index and the two vision shards of the LibertAI 3.5 bpw pack
ENGRAM_DIR="/var/tmp/tf1017/engram"        # shards 47 and 48 of deepseek-ai/DeepSeek-V4.1-Flash-1017 (the Engram tables)
ENGINE_DIR="/var/tmp/tf1017/engine-bin-p4"
KIT_DIR="/var/tmp/tf1017/kit"
CACHE_DIR="/var/tmp/tf1017/cache"
LOG_DIR="/var/tmp/tf1017/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

HOST=0.0.0.0                             # fleet endpoint: the LAN and the tailnet, no API key (the vLLM lane it replaces had none)
PORT=8000
SERVED_NAME=deepseek-v4.1-flash
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias glm-5.3-flash --temperature 1.0 --top-p 1.0 --top-k 20"   # sampling defaults: temperature 1.0, top_p 1.0 (the model README, what vLLM used) and top_k 20, because the engine's exact sampler needs 1 <= top_k <= 56 (no top_k = HTTP 500); a request that sends its own overrides them

CONTEXT=1048576
WINDOW=16777216
PARALLEL=16
ENGINE_ENV="TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID=3 NCCL_IB_GID_INDEX=3 TF_DS_2D_GU=parity TF_DS_ROUND_ROWS=48 TF_DS_STREAMS=16 TF_DS_SERVED_K=solo TF_DS_WINDOW=16777216"
FOLLOW_FLAGS="--round-rows 48 --streams 16 --pool 16777216 --context 1048576"
