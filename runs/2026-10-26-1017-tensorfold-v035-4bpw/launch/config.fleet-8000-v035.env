# FLEET :8000 on bertholomus recipe v0.3.5 (engine 0a0b69a + our 0003 RDMA GID + 0004 seed/top_k), 4.0 bpw, both rails (2026-10-26)
# Site settings for scripts/serve.sh. Copy to config.env (next to this file) or point DSV41_CONFIG at a copy.
# Sourced by bash: plain VAR=value lines. Every <PLACEHOLDER> must be replaced; the script refuses to start while one
# is left.

# --- the four nodes, rank 0 first (ranks 0-1 and 2-3 are the 2D split's two pairs) ----------------------------------
NODES="tonyspark2@192.168.192.2 tonyspark4@192.168.192.4 tonyspark3@192.168.192.3 tonyspark1@192.168.192.1"
MASTER_IP="192.168.192.2"
TP_PORT=29760                     # rank 0's rendezvous port (unauthenticated: keep it on the private link)
RDMA_HCA="rocep1s0f0,roceP2p1s0f0"
NET_IF="enp1s0f0np0"

# --- paths, the same on every node ------------------------------------------------------------------------------------
MODEL_DIR="/var/tmp/tf4/model"
ENGRAM_DIR="/var/tmp/tf1017/engram"
ENGINE_DIR="/var/tmp/tf4/engine-bin"
KIT_DIR="/var/tmp/tf4/kit"
CACHE_DIR="/var/tmp/tf4/cache"
LOG_DIR="/var/tmp/tf4/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# --- HTTP on rank 0 ---------------------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
SERVED_NAME=deepseek-v4.1-flash
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias glm-5.3-flash --temperature 1.0 --top-p 1.0 --top-k 20"

# --- the served settings, as measured in README.md --------------------------------------------------------------------
CONTEXT=1048576                   # a request's positions at most
WINDOW=20971520                   # the streams' shared positions (TF_DS_WINDOW and the followers' --pool)
# Nodes that need more room than 20971520 leaves (about 12 GiB free): 16777216 here, in TF_DS_WINDOW and in --pool.
PARALLEL=16
ENGINE_ENV="TF_RDMA_GID=3 NCCL_IB_GID_INDEX=3 TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_DS_2D_GU=parity TF_DS_ROUND_ROWS=48 TF_DS_STREAMS=16 TF_DS_SERVED_K=solo TF_DS_WINDOW=20971520 TF_DS_ROUND_MS=14.5,17.4,19.9,22.3,24.0,25.9,27.2,28.5,29.9,31.2,32.5,33.8,35.2,36.5,37.8,39.2,40.5,41.8,43.2,44.5,45.8,47.1,48.5,49.8,51.1,52.5,53.8,55.1,56.5,57.8,59.1,60.4,61.8,63.1,64.4,65.8,67.1,68.4,69.8,71.1,72.4,73.7,75.1,76.4,77.7,79.1,80.4,81.7 TF_DS_IDX_SPLIT=1 TENSORFOLD_PLAIN_SPECIALS=1 TENSORFOLD_GRAMMAR_LIB=/kit/grammar/libtfgrammar.so TENSORFOLD_SSE_KEEPALIVE=15 TENSORFOLD_STATS_EVERY=60 TF_FILL_CHUNKS=1 TF_FILL_MANY=1 TF_DS_2D_YX=1 TF_DS_WAVES=1 NCCL_MAX_NCHANNELS=4"
FOLLOW_FLAGS="--round-rows 48 --streams 16 --pool 20971520 --context 1048576"
RANK0_FLAGS="--prompt-cache-gib 2"  # rank 0's own flags, after --backend cuda: the kept prompt states may take 2 GiB
